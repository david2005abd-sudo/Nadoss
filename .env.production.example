# ============================================
# NADOS — Production Environment
# ============================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Supavisor transaction pooler (port 6543) — REQUIRED for Vercel serverless
SUPABASE_POOLED_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://nados.iq
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_ENVIRONMENT=production

# --- Security ---
CREDENTIALS_ENCRYPTION_KEY=<32+ chars random>
CRON_SECRET=<random secret>

# --- AI ---
OPENAI_API_KEY=sk-proj-...
EMBEDDING_MODEL=text-embedding-3-small

# --- WhatsApp ---
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=...
WHATSAPP_BUSINESS_ACCOUNT_ID=...
WHATSAPP_VERIFY_TOKEN=...
WHATSAPP_APP_SECRET=...

# --- Payments (iraqpay) ---
ZAINCASH_MSISDN=9647XXXXXXXXX
ZAINCASH_MERCHANT_ID=...
ZAINCASH_SECRET=...
FIB_CLIENT_ID=...
FIB_CLIENT_SECRET=...
QICARD_USERNAME=...
QICARD_PASSWORD=...
QICARD_TERMINAL_ID=...
NASSPAY_TOKEN=...
USD_IQD_RATE=1480

# --- Delivery ---
HI_EXPRESS_API_KEY=...
BOXY_API_KEY=...

# --- Monitoring ---
NEXT_PUBLIC_SENTRY_DSN=https://...@o...ingest.sentry.io/...
SENTRY_ORG=nados
SENTRY_PROJECT=nados-web
SENTRY_AUTH_TOKEN=...

# --- E2E (staging only) ---
E2E_BASE_URL=https://staging.nados.iq
E2E_OWNER_PHONE=07701234567
E2E_OWNER_PASSWORD=...

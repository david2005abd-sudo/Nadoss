# Copy to .env.local for local development. Never commit real credentials.
# Local values are printed by: npm run supabase:start && npx supabase status
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_APP_VERSION=0.1.5

# Supabase local API (replace keys with the values from "supabase status")
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_POOLED_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# AI and knowledge-base embeddings
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Payment providers — use sandbox credentials until staging verification
ZAINCASH_MSISDN=
ZAINCASH_MERCHANT_ID=
ZAINCASH_SECRET=
FIB_CLIENT_ID=
FIB_CLIENT_SECRET=
QICARD_USERNAME=
QICARD_PASSWORD=
QICARD_TERMINAL_ID=
NASSPAY_TOKEN=
WAYL_API_KEY=
WAYL_WEBHOOK_SECRET=

# Security and scheduled jobs
CREDENTIALS_ENCRYPTION_KEY=
CRON_SECRET=

# Monitoring (optional for local development)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Platform metrics / currency configuration
SAAS_CAC_USD=0
USD_IQD_RATE=1480

HI_EXPRESS_API_KEY=
BOXY_API_KEY=
E2E_BASE_URL=http://localhost:3000

# E2E defaults are configured by CI; do not use production credentials here.
E2E_OWNER_PHONE=07701234567
E2E_OWNER_PASSWORD=Test123456

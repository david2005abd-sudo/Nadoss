# ============================================
# NADOS - Environment Variables
# انسخ هذا الملف إلى .env.local واملأ القيم
# ============================================

# --- Supabase (إلزامي) ---
# أنشئ مشروعًا على https://supabase.com ثم انسخ المفاتيح
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- الموقع (إلزامي للإنتاج) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- الذكاء الاصطناعي (اختياري - للبوت) ---
OPENAI_API_KEY=sk-...

# --- WhatsApp Cloud API (اختياري - للبوت) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- التشفير (إلزامي: 32 حرفًا على الأقل) ---
CREDENTIALS_ENCRYPTION_KEY=change-me-to-a-strong-random-32-char-secret

# --- Cron Jobs (إلزامي) ---
CRON_SECRET=change-me-random-secret

# --- Economy ---
USD_IQD_RATE=1480
